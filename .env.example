# 楽天ウェブサービス（https://webservice.rakuten.co.jp/）でアプリを登録して取得する
# このファイルを .env にコピーして値を書く。.env はgitに載せない（.gitignore 済み）

# アプリID（UUID形式）
RAKUTEN_APPLICATION_ID=
# アクセスキー（pk_ で始まる）
RAKUTEN_ACCESS_KEY=
# アフィリエイトID（任意。付けると予約リンクがアフィリエイトつきになる）
RAKUTEN_AFFILIATE_ID=
# 楽天の「許可されたWebサイト」に登録したドメインのURL（例: github.com を登録したなら https://github.com/）。一致しないと403
RAKUTEN_REFERER=

# RapidAPI（https://rapidapi.com/）のキー。NAVITIME Route(totalnavi) を Basic（無料・月500回）で Subscribe して、Endpoints の X-RapidAPI-Key をコピーする
# 有料プランに切り替えるとお金がかかるキーなので、チャットやコミットに貼らない
RAPIDAPI_KEY=

# リクルートWEBサービス（https://webservice.recruit.co.jp/）のAPIキー。ホットペッパーグルメのグルメサーチAPIで使う。無料
HOTPEPPER_API_KEY=

# Google Cloud の Places API (New) のAPIキー（docs/google-places-setup.md）。使った分だけ料金がかかるキーなので、チャットやコミットに貼らない
GOOGLE_PLACES_API_KEY=

# Upstash（https://upstash.com/）の Redis。API を呼んだ回数を月ごとに数えるのに使う（src/lib/usageCounter.ts）
# 取り方：Upstash にログイン → Redis（Create Database）で データベースを作る → そのページの REST API の欄で取得
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
